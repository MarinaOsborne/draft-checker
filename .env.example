# PIN required to open the app (defaults to 2847 if unset)
ACCESS_PIN=2847

# OpenAI API key — used server-side only, never exposed to the browser
OPENAI_API_KEY=sk-...

# Model used for the analysis endpoint
OPENAI_MODEL=gpt-4o

# Port the Express server listens on (VibeCode requires 3000)
PORT=3000

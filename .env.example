# PIN required to open the app (defaults to 2847 if unset)
ACCESS_PIN=2847

# Anthropic API key — used server-side only, never exposed to the browser
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for the analysis endpoint
CLAUDE_MODEL=claude-sonnet-4-6

# Port the Express server listens on (VibeCode requires 3000)
PORT=3000

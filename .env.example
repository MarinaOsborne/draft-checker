# PIN required to open the app (defaults to 2847 if unset)
ACCESS_PIN=2847

# VibeCode platform API key — same key used for deployment. Used server-side
# only (both to call the AI Router below and, at deploy time, the VibeCode
# infra API); never exposed to the browser.
VIBE_KEY=vibe_api_...

# Model served through VibeCode's AI Router
VIBE_AI_MODEL=bitrix/bitrixgpt-5.5

# Base URL of VibeCode's OpenAI-compatible AI Router.
# ASSUMPTION — not verified against the real platform docs, see
# server/lib/vibeAiClient.js for details.
VIBE_AI_BASE_URL=https://vibecode.bitrix24.tech/v1/ai

# Port the Express server listens on (VibeCode requires 3000)
PORT=3000

# Password for GET/POST /admin/stats (usage stats: per-user run counts and
# token totals). Optional — if unset, the admin panel responds 500 and stays
# disabled rather than falling back to an open or default password.
ADMIN_PASSWORD=

# Google service account credentials (a service account key JSON file),
# base64-encoded onto a single line so it's safe to store as one .env value
# (the raw JSON has embedded newlines in its private_key field). Grant this
# service account read-only access to the Google Sheet below AND to every
# Google Doc it links to (share each as Viewer with the service account's
# client_email) — see server/lib/googleClient.js.
#   base64 -w0 service-account-key.json   # Linux
#   base64 service-account-key.json | tr -d '\n'   # macOS/BSD
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# ID of the Google Sheet listing articles (the long id in its URL, between
# /d/ and /edit). One tab per language (EN/ES/BR/DE/FR/TR/PL/VN/IT — same
# codes as the UI's language switcher), each tab with header row: id, Title,
# "draft" (AI draft doc), "Link to content" (editor's edited/final doc) —
# note this is the reverse of what the column names suggest, confirmed
# against the real sheet. The client sends the selected language on every
# /api/article-list* request, and the server reads that language's tab
# directly (`${tab}!A:Z`) — see server/lib/googleClient.js::sheetTabForLanguage.
# If a tab's real name doesn't match its language code exactly (Sheets
# ranges are case-sensitive), override that one entry in
# LANGUAGE_SHEET_TABS there rather than renaming the tab.
GOOGLE_SHEET_ID=

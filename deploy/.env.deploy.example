# Скопируй в deploy/.env.deploy и впиши свои значения.
# Этот файл (без .example) в гит не попадает — см. .gitignore.

VIBE_KEY=vibe_api_...
ACCESS_PIN=2847

# Опционально — если после деплоя /api/analyze падает 502, проверь реальный
# путь AI Router в личном кабинете VibeCode и переопредели здесь:
# VIBE_AI_BASE_URL=https://vibecode.bitrix24.tech/v1/ai
# VIBE_AI_MODEL=bitrix/bitrixgpt-5.5

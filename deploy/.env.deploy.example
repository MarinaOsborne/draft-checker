# Скопируй в deploy/.env.deploy и впиши свои значения.
# Этот файл (без .example) в гит не попадает — см. .gitignore.

VIBE_KEY=vibe_api_...
ACCESS_PIN=2847

# Опционально — если после деплоя /api/analyze отвечает ai_unavailable/
# analyze_failed, проверь реальный путь AI Router в личном кабинете VibeCode
# и переопредели здесь:
# VIBE_AI_BASE_URL=https://vibecode.bitrix24.tech/v1/ai
# VIBE_AI_MODEL=bitrix/bitrixgpt-5.5

# Опционально — пароль для GET/POST /admin/stats (статистика использования).
# Без него админ-панель отвечает 500 и остаётся отключённой.
# ADMIN_PASSWORD=

# Нужны для интеграции с Google Docs (выбор статьи из выпадающего списка
# вместо загрузки .docx) — одна таблица, вкладка на каждый язык
# (EN/ES/BR/DE/FR/TR/PL/VN/IT) — см. server/lib/googleClient.js и .env.example.
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# GOOGLE_SHEET_ID=

# ВРЕМЕННО — включает /admin/env-check* (разовая проверка окружения VibeCode
# Galaxy: постоянный том /data, число экземпляров, фоновое выполнение после
# ответа — см. server/routes/envProbes.js). Ставь true только на время самой
# проверки. ⚠️ Если строка осталась тут после проверки — ОБЯЗАТЕЛЬНО удали её
# (или поставь false) перед следующим обычным деплоем: deploy.sh читает этот
# файл, и "просто не напечатать переменную в терминале" не отключит её, если
# она сохранена здесь.
# ENABLE_ENV_PROBES=true

# То же самое предупреждение, что выше — ВРЕМЕННО, для одного конкретного
# деплоя-миграции, удали/обнули перед следующим обычным деплоем. Включает
# /admin/export-analytics, /admin/export-diagnostics, /admin/restore-data.
# ENABLE_DATA_MIGRATION=true

# Пусто по умолчанию (данные живут в process.cwd()+"/data", сейчас это
# /opt/app/data — не переживает деплой). Переключай на постоянный том ТОЛЬКО
# после резервного копирования текущих данных через /admin/export-analytics
# /admin/export-analysis /admin/export-diagnostics и восстановления их на
# новом месте через /admin/restore-data — см. CLAUDE.md.
# DATA_DIR=/data
